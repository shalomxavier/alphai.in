---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceColumn from '../components/ServiceColumn.astro';
import { services } from '../data/services';

const words = 'Where Intelligence Becomes Action.'.split(' ');
---

<BaseLayout
  title="ALPHAI"
  description="ALPHAI — intelligent software, AI and digital growth. Web & dashboard development, AI & business automation, SEO & digital growth."
  hideFooter
>
  <!-- HERO — centered brand lockup -->
  <section
    class="relative flex flex-1 flex-col"
    data-hero
    aria-label="ALPHAI — intelligent software, AI and digital growth"
  >
    <div
      class="shell flex flex-1 flex-col items-center justify-center pt-14 pb-4 text-center"
    >
      <div class="flex items-center gap-3" data-hero-meta>
        <img
          src="/alphai-logo.svg"
          alt=""
          width="1400"
          height="688"
          class="h-[0.8em] w-auto"
        />
        <span class="text-lg font-medium tracking-tightest md:text-xl"
          >ALPHAI</span
        >
      </div>
      <h1
        class="mt-8 max-w-4xl text-h1 font-medium leading-tight tracking-tightest md:mt-10"
        aria-label="Where Intelligence Becomes Action."
        data-hero-wordmark
      >
        {
          words.map((word, i) => (
            <Fragment>
              <span class="mask" aria-hidden="true">
                <span data-hero-letter>{word}</span>
              </span>
              {i < words.length - 1 && ' '}
            </Fragment>
          ))
        }
      </h1>
      <p class="mt-6 w-full max-w-xl text-muted" data-hero-meta>
        Intelligent software, AI and digital growth for modern businesses.
      </p>
    </div>
  </section>

  <!-- SERVICES — three editorial columns -->
  <section id="services" class="pb-8" aria-label="Services">
    <div class="shell">
      <div
        class="grid divide-y divide-line border-y hairline md:grid-cols-3 md:divide-x md:divide-y-0"
        data-animate="stagger"
      >
        {services.map((service) => <ServiceColumn {...service} />)}
      </div>
      <div class="mt-6 flex justify-center">
        <a
          href="/contact"
          class="inline-block bg-accent px-10 py-4 font-medium text-ink transition-transform duration-300 ease-[var(--ease-out-expo)] hover:-translate-y-0.5"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
