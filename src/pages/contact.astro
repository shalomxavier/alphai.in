---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact ALPHAI — tell us what you're building, improving or trying to solve."
>
  <section
    class="shell flex min-h-[78svh] flex-col pt-32 md:pt-44"
    aria-label="Contact ALPHAI"
  >
    <p class="label" data-animate="fade-in">Contact</p>

    <h1
      class="text-h1 mt-8 max-w-4xl font-medium leading-tight tracking-tightest"
      data-parallax="-6"
    >
      Let&rsquo;s build something useful.
    </h1>

    <p
      class="mt-10 max-w-xl text-body-lg text-muted"
      data-animate="fade-up"
      data-animate-delay="0.1"
    >
      Tell us what you&rsquo;re building, improving or trying to solve.
    </p>

    <div class="mt-auto pb-16 md:pb-24">
      <div class="overflow-hidden">
        <a
          href="mailto:hello@alphai.in"
          class="email-link inline-flex items-baseline gap-4 text-h2 font-medium leading-tight tracking-tightest wrap-anywhere md:text-h1"
          data-animate="mask-up"
        >
          hello@alphai.in
          <span
            aria-hidden="true"
            class="email-arrow text-muted transition-all duration-500 ease-[var(--ease-out-expo)]"
            >↗</span
          >
        </a>
      </div>

      <a
        href="mailto:hello@alphai.in"
        class="label mt-6 inline-block text-paper/70 transition-colors duration-300 hover:text-paper"
        data-animate="fade-up"
        data-animate-delay="0.15"
      >
        Send an email ↗
      </a>
    </div>
  </section>

  <!-- quiet metadata strip -->
  <div class="border-t hairline">
    <div class="shell flex items-center justify-between gap-6 py-6">
      <p class="label">ALPHAI.IN</p>
      <p class="label hidden sm:block">Software · AI · Digital growth</p>
    </div>
  </div>
</BaseLayout>

<style>
  .email-link {
    position: relative;
    transition: color 0.4s var(--ease-out-expo);
  }
  .email-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out-expo);
  }
  .email-link:hover::after,
  .email-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .email-link:hover .email-arrow,
  .email-link:focus-visible .email-arrow {
    transform: translate(6px, -6px);
    color: var(--color-accent);
  }
</style>
