---
interface Props {
  index: string;
  title: string;
  summary?: string;
  href: string;
  meta?: string;
}

const { index, title, summary, href, meta } = Astro.props;
---

<a
  href={href}
  class="group relative block overflow-hidden border-t hairline"
>
  <!-- paper fill sweep -->
  <span
    aria-hidden="true"
    class="absolute inset-0 origin-bottom scale-y-0 bg-paper transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-y-100 group-focus-visible:scale-y-100"
  ></span>

  <span
    class="shell relative flex items-baseline justify-between gap-6 py-8 transition-colors duration-500 group-hover:text-ink group-focus-visible:text-ink md:py-12"
  >
    <span class="flex items-baseline gap-5 md:gap-12">
      <span
        class="label shrink-0 transition-colors duration-500 group-hover:text-ink/50 group-focus-visible:text-ink/50"
        >{index}</span
      >
      <span>
        <span
          class="block text-h3 font-medium tracking-tightest transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-3 group-focus-visible:translate-x-3 md:text-h2"
          >{title}</span
        >
        {
          summary && (
            <span class="mt-3 block max-w-md text-muted transition-colors duration-500 group-hover:text-ink/60 group-focus-visible:text-ink/60">
              {summary}
            </span>
          )
        }
      </span>
    </span>
    <span class="flex items-baseline gap-8">
      {
        meta && (
          <span class="label hidden transition-colors duration-500 group-hover:text-ink/50 group-focus-visible:text-ink/50 md:inline">
            {meta}
          </span>
        )
      }
      <span
        aria-hidden="true"
        class="text-h3 text-muted transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-2 group-hover:text-accent group-focus-visible:translate-x-2 group-focus-visible:text-accent md:text-h2"
        >→</span
      >
    </span>
  </span>
</a>
