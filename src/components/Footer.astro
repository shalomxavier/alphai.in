---
const year = new Date().getFullYear();
---

<footer class="border-t hairline">
  <div
    class="shell flex items-center justify-between gap-6 py-3"
  >
    <p class="label flex items-center gap-3">
      <img
        src="/alphai-logo.svg"
        alt=""
        width="1400"
        height="688"
        class="h-4 w-auto"
      />© {year} ALPHAI
    </p>
    <p class="label hidden sm:block">Software · AI · Digital growth</p>
    <a
      href="#top"
      class="label text-paper/70 transition-colors duration-300 hover:text-paper"
      >Back to top ↑</a
    >
  </div>
</footer>
