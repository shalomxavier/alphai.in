---
interface Props {
  text?: string;
}

const { text = 'Start a conversation' } = Astro.props;
---

<a href="/contact" class="group block border-b hairline" data-animate="fade-up">
  <div class="shell flex items-baseline justify-between gap-6 py-8 md:py-10">
    <span class="label">Contact</span>
    <span class="flex items-baseline gap-4 text-body-lg">
      {text}
      <span
        aria-hidden="true"
        class="text-muted transition-all duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-2 group-hover:text-accent"
        >→</span
      >
    </span>
  </div>
</a>
