---
interface Props {
  index: string;
  title: string;
  summary?: string;
  href: string;
}

const { index, title, summary, href } = Astro.props;
---

<a href={href} class="group block h-full px-6 py-5 md:px-8">
  <span class="label">{index}</span>
  <span
    class="mt-4 block text-h3 font-medium tracking-tightest transition-colors duration-300 group-hover:text-accent group-focus-visible:text-accent"
  >
    {title}
  </span>
  {
    summary && (
      <span class="mt-3 block text-muted">{summary}</span>
    )
  }
</a>
